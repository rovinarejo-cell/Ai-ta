# Development only. Copy to .env locally; environment variables take precedence.
DJANGO_SETTINGS_MODULE=config.settings.development
# Supply a stable randomly generated key privately for authenticated session persistence.
# Empty is for throwaway development only: restart invalidates existing sessions.
# Production requires a strong external key (never committed).
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite remains the default. PostgreSQL variables alone do not switch engines.
# To opt in, set DATABASE_ENGINE=postgresql and provide all four required fields.
# Selection/configuration/connection errors never fall back to another database.
DATABASE_ENGINE=sqlite
# Safe empty placeholders only: supply your own values privately in .env.
# Name of the database created for this application.
POSTGRES_DB=
# Non-superuser database login role that owns that database.
POSTGRES_USER=
# Set through a secure local prompt/configuration, never commit the value.
POSTGRES_PASSWORD=
# Hostname/IP of your authorized PostgreSQL instance (e.g. localhost locally).
POSTGRES_HOST=
# Optional: unset or empty uses 5432; must be an integer from 1 through 65535.
POSTGRES_PORT=5432
# Defaults to verify-full. Production enforces this mode.
POSTGRES_SSLMODE=verify-full
# libpq reads PGSSLROOTCERT for a trusted CA certificate path when required.
# Example variable name only; configure the actual path privately if needed:
# PGSSLROOTCERT=
# disable is allowed only for an explicitly chosen local development PostgreSQL
# instance without TLS. Production rejects it; never disable production trust.
